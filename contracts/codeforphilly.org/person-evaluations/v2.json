{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codeforphilly.org/person-evaluations/v2",
  "title": "Person evaluation",
  "type": "object",
  "properties": {
    "personSlug": {
      "type": "string",
      "minLength": 1
    },
    "evaluator": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "spam",
        "legit",
        "uncertain"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "score": {
      "type": "integer"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasoning": {
      "type": "string"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "evaluatedAt",
    "evaluator",
    "flags",
    "personSlug",
    "verdict"
  ]
}
